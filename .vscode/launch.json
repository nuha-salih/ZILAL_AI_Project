{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ZILAL AI (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Check environment",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/check_env.py",
      "console": "integratedTerminal"
    }
  ]
}
